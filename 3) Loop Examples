static void FirstQuestion()
{
    double totalPrice = 0;
    double itemPrice = 0;
    int managerPin = 1234;
    bool shopping = true;

    Console.WriteLine();

    Console.WriteLine("--- Smart Checkout System ---");
    Console.WriteLine("Please enter the item price (enter 0 to finish):");

    while (shopping)
    {
        Console.WriteLine("Scan item price:");
        itemPrice = Convert.ToDouble(Console.ReadLine());

        if (itemPrice == 0)
        {
            shopping = false;
            break;
        }

        if (itemPrice >= 100)
        {
            Console.WriteLine("! Manager approval required for high-value item ($100+) !");
            Console.WriteLine("Manager, please enter override PIN:");
            int enteredPin = Convert.ToInt32(Console.ReadLine());

            if (enteredPin == managerPin)
            {
                Console.WriteLine("Correct PIN. Item is approved and added.");
                totalPrice += itemPrice;
            }
            else
            {
                Console.WriteLine("Incorrect PIN. Item is rejected and not added.");
            }
        }
        else
        {
            totalPrice += itemPrice;
        }
        Console.WriteLine("Current total: ${0}", totalPrice);
    }
    Console.WriteLine("---------------------------------");
    Console.WriteLine();
    Console.WriteLine("Your Receipt Total: ${0}", totalPrice);
    Console.WriteLine("Thank you for shopping with us!");
    Console.WriteLine();
    Console.WriteLine();
    Console.WriteLine();
}


static void SecondQuestion()
{
    string enteredPassword = "";
    string correctPassword = "mis3013isgreat!";
    double attemptsUsed = 0;
    double maxAttempts = 3;
    bool isAccessGranted = false;
    
    Console.WriteLine();

    Console.WriteLine("--- Password Cracker ---");

    do
    {
        Console.WriteLine("Please enter the security password:");
        enteredPassword = Console.ReadLine();
        attemptsUsed++;

        if (enteredPassword == correctPassword)
        {
            isAccessGranted = true;
        }
        else if (attemptsUsed < maxAttempts)
        {
            Console.WriteLine("Incorrect. You have {0} attempts remaining.", maxAttempts - attemptsUsed);
        }
    }
    while (!isAccessGranted && attemptsUsed < maxAttempts);

    Console.WriteLine();

    if (isAccessGranted)
    {
        Console.WriteLine("Access granted.");
    }
    else
    {
        Console.WriteLine("Security Lockdown Initiated!");
    }

    Console.WriteLine();
    Console.WriteLine("Press any key to return to menu...");
    Console.ReadKey();
}

