// Another version of the Student class with a constructor and an additional method

public class Student(string studentName = "Unknown", int studentGrade = 0) // constructor with default parameters
{
    public string name = studentName;
    public int grade = studentGrade;

    public void Introduce()
    {
        Console.WriteLine($"Hello, my name is {name}.");
        Console.WriteLine($"My grade is {grade}.");
    }
}

public class Program
{
    public static void Main()
    {
        Student StudentC = new Student(); // using default parameters
        StudentC.Introduce();

        Student StudentD = new Student("Alice", 85); // using custom parameters
        StudentD.Introduce();
    }
}
